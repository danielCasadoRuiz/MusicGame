    {
      "start": 18.84,
      "end": 20.76,
      "text": "Lindyhop"
    },
    {
      "start": 23.98,
      "end": 26.06,
      "text": "That pulse-pulse rhythm sets my chest alight"
    },
    {
      "start": 26.06,
      "end": 29.0,
      "text": "One tender touch sends every nerve in flight"
    },
    {
      "start": 29.0,
      "end": 31.98,
      "text": "Lindyhop rattles through my veins"
    },
    {
      "start": 31.98,
      "end": 34.58,
      "text": "Clap-a-clap-a-clap sets both shoes into play"
    },
    {
      "start": 34.58,
      "end": 36.56,
      "text": "A restless whisper won't let me be"
    },
    {
      "start": 36.56,
      "end": 37.2,
      "text": "Nothing seems aligned"
    },
    {
      "start": 37.62,
      "end": 40.5,
      "text": "A trusted pal revealed your escapade past midnight"
    },
    {
      "start": 40.5,
      "end": 43.28,
      "text": "Drowsing alone beneath the spread"
    },
    {
      "start": 43.28,
      "end": 46.72,
      "text": "Lost in a haze when I belonged there next to you"
    },
    {
      "start": 46.72,
      "end": 48.94,
      "text": "Rouse me first! then, you roam-roam!"
    },
    {
      "start": 48.94,
      "end": 51.68,
      "text": "Never strand me swaying there in lim-bo!"
    },
    {
      "start": 52.4,
      "end": 54.58,
      "text": "Rouse me early, then you roam-roam!"
    },
    {
      "start": 54.58,
      "end": 58.1,
      "text": "I can't bear to lose that rush when both can-fly!"
    },
    {
      "start": 58.1,
      "end": 60.24,
      "text": "Rouse me early! then, you roam-roam!"
    },
    {
      "start": 60.24,
      "end": 63.02,
      "text": "Moving together beats a one man-show!"
    },
    {
      "start": 63.02,
      "end": 64.06,
