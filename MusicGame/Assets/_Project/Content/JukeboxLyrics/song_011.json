  "language": "en",
  "audioSha256": "69e443891703fa308cc3a26c3602163de9e32749213907c1a1eb3643f70f0a92",
  "duration": 359.6,
  "textSource": "recovered_final_lyrics",
  "timingSource": "whisper_automatic_alignment",
  "offset": 0,
  "lines": [
    {
      "start": 27.66,
      "end": 29.9,
      "text": "What does it mean"
    },
    {
      "start": 29.9,
      "end": 33.4,
      "text": "To handle me this way?"
    },
    {
      "start": 35.8,
      "end": 39.54,
      "text": "When you put your hands around me"
    },
    {
      "start": 39.54,
      "end": 42.2,
      "text": "And showed me what you were?"
    },
    {
      "start": 42.2,
      "end": 46.2,
      "text": "I feared I'd read it wrongly"
    },
    {
      "start": 46.2,
      "end": 49.42,
      "text": "I swore I caught your voice"
    },
    {
      "start": 50.28,
      "end": 53.26,
      "text": "Say, what am I to feel?"
    },
    {
      "start": 53.26,
      "end": 58.92,
      "text": "Say it now, what should I feel?"
    },
    {
      "start": 72.7,
      "end": 75.48,
      "text": "All the ones before me"
    },
    {
      "start": 75.48,
      "end": 79.4,
      "text": "Carried out their stations"
    },
    {
      "start": 79.4,
      "end": 82.68,
      "text": "From beginnings through conclusion"
    },
    {
      "start": 82.68,
      "end": 86.48,
      "text": "They won't look back again"
    },
    {
      "start": 86.48,
      "end": 90.06,
      "text": "Yet still, it comes so slowly"
    },
    {
      "start": 90.06,
      "end": 93.72,
      "text": "To speak what I need heard"
    },
    {
      "start": 93.72,
      "end": 97.64,
      "text": "But I am certain you'll inform me"
    },
    {
      "start": 97.64,
      "end": 102.5,
      "text": "What I'm meant to feel today"
    },
    {
      "start": 137.84,
      "end": 141.1,
      "text": "There's a boat out in the harbour"
    },
    {
      "start": 141.1,
      "end": 144.62,
      "text": "I know I must comply"
    },
    {
      "start": 144.62,
      "end": 148.52,
      "text": "But without all of your bad fortune"
    },
    {
      "start": 148.52,
      "end": 153.68,
      "text": "I'd be someone close to heaven today"
    },
    {
      "start": 153.68,
      "end": 157.52,
      "text": "And I feared I'd read it wrongly"
    },
    {
      "start": 157.52,
      "end": 161.22,
      "text": "And I swore I caught you speaking"
    },
    {
      "start": 161.22,
      "end": 164.66,
      "text": "Say, what am I to feel?"
    },
    {
      "start": 165.64,
      "end": 168.4,
      "text": "Say it now, what should I feel?"
    },
    {
      "start": 172.52,
      "end": 175.44,
      "text": "Now I'm frozen here in place"
    },
    {
      "start": 226.44,
      "end": 231.08,
      "text": "I was sure I'd sent you from me"
    },
    {
      "start": 231.08,
      "end": 238.02,
      "text": "As I made my way toward the shore"
    },
    {
      "start": 239.56,
      "end": 245.46,
      "text": "Say, what does that do to you"
    },
    {
      "start": 246.54,
      "end": 254.16,
      "text": "When your heart turns numb?"
    },
    {
      "start": 254.16,
      "end": 268.0,
      "text": "(Turns numb, turns numb, turns numb, turns numb)"
    }
  ]
}
