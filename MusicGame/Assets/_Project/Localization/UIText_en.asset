    m_Metadata:
      m_Items: []
  - m_Id: 15185400538128415
    m_Localized: "Keyboard: J = Punch \xB7 K = Kick \xB7 WASD or arrows = move. \u2192
      means towards the rival, \u2190 away from them."
    m_Metadata:
      m_Items: []
  - m_Id: 15185400538128416
    m_Localized: "Joystick to move, PUNCH and KICK buttons to attack. \u2192 means
      towards the rival, \u2190 away from them."
