  m_TableData:
  - m_Id: 3248276168704
    m_Localized: "Analitzant la can\xE7\xF3..."
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111744
    m_Localized: Extraient l'estil musical...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111745
    m_Localized: Mesurant el flow...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111746
    m_Localized: Comptant els beats per minut...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111747
    m_Localized: Desxifrant el ritme...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111748
    m_Localized: Escoltant el bombo...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111749
    m_Localized: Mapejant els hi-hats...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111750
    m_Localized: Detectant els drops...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111751
    m_Localized: "Llegint l'\xE0nim de la can\xE7\xF3..."
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111752
    m_Localized: "Calibrant la f\xEDsica dels salts..."
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111753
    m_Localized: "Sintonitzant les freq\xFC\xE8ncies..."
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111754
    m_Localized: "Ensenyant el circuit a c\xF3rrer..."
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111755
    m_Localized: "Sincronitzant el ritme amb el m\xF3n..."
    m_Metadata:
      m_Items: []
