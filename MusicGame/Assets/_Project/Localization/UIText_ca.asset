  - m_Id: 3248276168704
    m_Localized: "Analitzant la can\xE7\xF3..."
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111744
    m_Localized: Extraient l'estil musical...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111745
    m_Localized: Mesurant el flow...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111746
    m_Localized: Comptant els beats per minut...
    m_Metadata:
      m_Items: []
  - m_Id: 3248318111747
