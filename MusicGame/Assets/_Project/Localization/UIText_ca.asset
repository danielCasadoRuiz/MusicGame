    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705686
    m_Localized: contingut de desenvolupament
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705687
    m_Localized: "Completada abans que existissin les qualificacions: torna a jugar
      aquesta posici\xF3 en una nova volta per puntuar-la."
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705688
    m_Localized: Encara no s'ha jugat.
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705689
    m_Localized: volta {0}
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705690
    m_Localized: Darrera cursa
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705691
    m_Localized: Darrer combat
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705692
    m_Localized: (derrota)
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705693
    m_Localized: 'Dominada: cursa i combat a 5 estrelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705694
    m_Localized: "Cursa: encara sense qualificaci\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705695
    m_Localized: "Cursa: arriba al {0}% del m\xE0xim (totes les recollides, temps
      perfecte i sense caigudes) per a 5 estrelles."
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705696
    m_Localized: 'Combat: guanya''l per registrar-ne el resultat.'
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705697
    m_Localized: 'Combat: guanya sense rebre cap dany (perfect) per a 5 estrelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705698
    m_Localized: "Aquesta posici\xF3 torna a cada nova volta."
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705699
    m_Localized: "Nivell {0} \xB7 partida {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705700
    m_Localized: NIVELL {0}
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705701
    m_Localized: Has completat tots els nivells!
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705702
    m_Localized: "Per desafiar l'\xE9sser de la m\xFAsica, domina totes les partides
      amb cinc estrelles i completa la col\xB7lecci\xF3 dels grans mestres.\nComen\xE7a
      una nova volta per millorar les teves marques i trobar els rivals que et falten."
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705703
    m_Localized: NOVA VOLTA
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705704
    m_Localized: "M\xC9S TARD"
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705705
    m_Localized: D'ACORD
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705706
    m_Localized: DESAFIA
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705707
    m_Localized: Volta {0} completada!
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705708
    m_Localized: "Comen\xE7a una nova volta des del nivell 1: conserves els r\xE8cords
      i els cromos."
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705709
    m_Localized: "L'\xE9sser de la m\xFAsica t'espera"
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705710
    m_Localized: "Totes les partides dominades i tots els mestres derrotats. Tres
      combats et separen del concepte mateix de la m\xFAsica."
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705711
    m_Localized: "Has derrotat l'\xE9sser de la m\xFAsica!"
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705712
    m_Localized: "Has superat el repte final. El pots tornar a desafiar quan vulguis
      per millorar els teus r\xE8cords."
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705713
    m_Localized: "M\xE9s enll\xE0 de la m\xFAsica"
    m_Metadata:
      m_Items: []
  - m_Id: 12057460350705714
    m_Localized: "Cinc estrelles als tres combats finals: has superat tots els grans
      mestres i fins i tot el concepte de la m\xFAsica."
    m_Metadata:
      m_Items: []
