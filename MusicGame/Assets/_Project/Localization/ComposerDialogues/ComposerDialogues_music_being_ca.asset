%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ComposerDialogues_music_being_ca
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: a53db399ebd1bfa40802d506c88e745d, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1528356864
    m_Localized: "Aix\xED que tu ets qui ha ven\xE7ut els meus alumnes? Jo era aqu\xED
      abans que la primera nota."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077120
    m_Localized: "Bach, Mozart, Wagner... tots em demanaven perm\xEDs. Tu ni has
      trucat."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077121
    m_Localized: "Aquesta can\xE7\xF3 teva... la vaig descartar fa deu mil anys.
      Massa previsible."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077122
    m_Localized: Soc el do, el re i el mi alhora. Tu, com a molt, un soroll de fons.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077123
    m_Localized: "Abans que exist\xEDs el ritme, jo ja picava de peus. Comencem?"
    m_Metadata:
      m_Items: []
  - m_Id: 1587077124
    m_Localized: M'han invocat amb un loop de quatre compassos? Quina falta de respecte.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077125
    m_Localized: "Tranquil, nom\xE9s far\xE9 servir una octava. De moment."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077126
    m_Localized: "El silenci tamb\xE9 \xE9s m\xFAsica. Ara en sentir\xE0s molt, de
      silenci."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077127
    m_Localized: "Has afinat abans de venir? Ho sento des d'aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077128
    m_Localized: "Benvingut a l'escenari original. L'ac\xFAstica \xE9s perfecta:
      la vaig fer jo."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077129
    m_Localized: Hm. Un acord inesperat. M'ha agradat... una mica.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077130
    m_Localized: Has tocat a temps. Tres vegades seguides. Ho apunto.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077131
    m_Localized: "Aquesta s\xEDncope no la tenia prevista. I jo ho preveig tot."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077132
    m_Localized: "D'acord, d'acord: tens m\xE9s ritme del que sembla."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077133
    m_Localized: "Primer comp\xE0s per a tu. La partitura encara \xE9s llarga."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077134
    m_Localized: "M'has desafinat. Ning\xFA m'havia desafinat mai. Interessant."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077135
    m_Localized: "B\xE9. Has superat l'escala de do major. Ara ve la complicada."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077136
    m_Localized: "Reconec la melodia. Era meva, per\xF2 l'has dit amb gr\xE0cia."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077137
    m_Localized: "Una cad\xE8ncia perfecta... contra mi. Quina barra."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077138
    m_Localized: "Aplaudir\xE9. Nom\xE9s amb una m\xE0, que l'altra porta el comp\xE0s."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077139
    m_Localized: Tornes a l'assaig. Jo ja era a l'estrena.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077140
    m_Localized: T'has quedat en un silenci de negra. Molt llarg.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077141
    m_Localized: "Una altra vegada? \xC9s clar. La m\xFAsica sempre torna al tema."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077142
    m_Localized: Ho sento, aquest final l'he escrit jo.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077143
    m_Localized: "Tens potencial. Com un triangle a l'\xFAltima fila."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077144
    m_Localized: "Has perdut el comp\xE0s. Me'l quedo: tots els compassos s\xF3n
      meus."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077145
    m_Localized: Ni un do de pit. Ni un do de res.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077146
    m_Localized: Bravo! Ah no, era l'eco del meu propi bravo.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077147
    m_Localized: 'Estudia solfeig i torna. Jo t''espero: tinc tota l''eternitat.'
    m_Metadata:
      m_Items: []
  - m_Id: 1587077148
    m_Localized: "El p\xFAblic demana un bis. De mi, no de tu."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077149
    m_Localized: "Has tornat. Ara tocar\xE9 amb tota l'orquestra."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077150
    m_Localized: "Abans nom\xE9s afinava. Ara comen\xE7a la simfonia."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077151
    m_Localized: "Sento el teu cor: va a 140 bpm. Massa r\xE0pid per a un adagio."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077152
    m_Localized: Cada nota que toques, jo ja l'he tocada abans. I millor.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077153
    m_Localized: "Avui modular\xE9 a un to que encara no t\xE9 nom."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077154
    m_Localized: "El metr\xF2nom \xE9s meu. I ara mateix s'est\xE0 accelerant."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077155
    m_Localized: Porto vuitanta violins a dins. Tots desafinen contra tu.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077156
    m_Localized: Els grans mestres eren assajos. Tu ets la prova de so.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077157
    m_Localized: Prepara't per a un crescendo que no s'acaba mai.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077158
    m_Localized: "Aquest cop res de silencis. Tot ser\xE0 fortissimo."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077159
    m_Localized: Has sobreviscut al meu tutti. Pocs ho poden explicar.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077160
    m_Localized: Aquest contrapunt l'havia de fer jo. Me l'has robat.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077161
    m_Localized: "B\xE9. Et mereixes un acord de setena. No m\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077162
    m_Localized: M'has fet perdre l'entrada. A mi, que soc totes les entrades.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077163
    m_Localized: "Accepto la derrota com un calder\xF3: breu i elegant."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077164
    m_Localized: "La teva melodia tenia alguna cosa... no s\xE9 qu\xE8. Ja ho descobrir\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077165
    m_Localized: "Segon moviment per a tu. El tercer \xE9s el meu preferit."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077166
    m_Localized: "Has trobat la nota blava. I jo que l'havia amagat tan b\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077167
    m_Localized: 'D''acord: et deixo tocar a la meva banda. De moment, la pandereta.'
    m_Metadata:
      m_Items: []
  - m_Id: 1587077168
    m_Localized: Has fet ressonar l'harmonia. Em fa pessigolles.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077169
    m_Localized: La simfonia s'acaba quan jo ho dic. I ho dic ara.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077170
    m_Localized: Massa notes i massa poques idees.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077171
    m_Localized: "Has ensopegat en un comp\xE0s de 7/8. Un cl\xE0ssic."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077172
    m_Localized: M'ha agradat la teva derrota. Tenia bon tempo.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077173
    m_Localized: Tot l'auditori en silenci. Per respecte. A mi.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077174
    m_Localized: Has tocat amb sentiment. El sentiment equivocat.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077175
    m_Localized: "Et regalo una partitura en blanc. Comen\xE7a per aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077176
    m_Localized: "No pateixis: la hist\xF2ria et recordar\xE0 com una nota a peu
      de p\xE0gina."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077177
    m_Localized: El teu solo ha durat menys que un glissando.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077178
    m_Localized: "Tornar\xE0s. Tothom acaba tornant a la t\xF2nica."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077179
    m_Localized: Ja no soc una orquestra. Soc el so de l'univers.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077180
    m_Localized: "Les estrelles vibren a la meva freq\xFC\xE8ncia. Tu tamb\xE9 vibrar\xE0s."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077181
    m_Localized: Abans del Big Bang hi va haver un compte enrere. El vaig marcar
      jo.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077182
    m_Localized: "Aquesta \xE9s la meva forma final: totes les can\xE7ons alhora."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077183
    m_Localized: "Cada vegada que alg\xFA taral\xB7lejava, era jo. Ara taral\xB7lejar\xE9
      contra tu."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077184
    m_Localized: "Has derrotat els mestres i les meves orquestres. Nom\xE9s queda
      el silenci absolut."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077185
    m_Localized: "Ho sento, aqu\xED no hi ha bot\xF3 de pausa. No n'hi ha hagut mai."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077186
    m_Localized: "Si guanyes, la m\xFAsica ser\xE0 teva. Si perds, ser\xE0s un acord
      de fons."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077187
    m_Localized: "Tota la hist\xF2ria de la m\xFAsica cap en aquest comp\xE0s. Endavant."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077188
    m_Localized: "Escolta b\xE9: aquest \xE9s l'\xFAltim la que sentir\xE0s per afinar."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077189
    m_Localized: "Incre\xEFble. M'has superat... i encara sonava b\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077190
    m_Localized: "D'acord. A partir d'ara, quan alg\xFA canti a la dutxa, pensar\xE9
      en tu."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077191
    m_Localized: "M'has tocat de mem\xF2ria. Ni jo em sabia tan b\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077192
    m_Localized: Accepto. La propera simfonia te la dedico. A contracor.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077193
    m_Localized: Has trobat l'acord perdut. Jo el buscava des de sempre.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077194
    m_Localized: "Molt b\xE9, mestre. Per\xF2 que consti que el ritme el vaig inventar
      jo."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077195
    m_Localized: "Has fet callar la mateixa m\xFAsica. Qui sap qu\xE8 sonar\xE0 ara."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077196
    m_Localized: "Una ovaci\xF3 de les gal\xE0xies. Fan molt de soroll, les gal\xE0xies."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077197
    m_Localized: "Has guanyat l'\xFAltima nota. Gaudeix-la, que dura poc."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077198
    m_Localized: "Abaixa el tel\xF3. I no toquis res: el piano \xE9s meu."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077199
    m_Localized: "L'univers continua afinat. Gr\xE0cies per participar."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077200
    m_Localized: Has estat molt a prop. Mig to, com a molt.
    m_Metadata:
      m_Items: []
  - m_Id: 1587077201
    m_Localized: "La m\xFAsica sempre guanya. Ho porta al nom."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077202
    m_Localized: "Torna a comen\xE7ar des del primer comp\xE0s. T'espero al final."
    m_Metadata:
      m_Items: []
  - m_Id: 1587077203
    m_Localized: "Bon intent. El posar\xE9 en un recopilatori de rareses."
    m_Metadata:
      m_Items: []
  - m_Id: 1599660032
    m_Localized: "Has perdut contra un concepte. El concepte est\xE0 encantat."
    m_Metadata:
      m_Items: []
  - m_Id: 1599660033
    m_Localized: Les estrelles riuen en do major.
    m_Metadata:
      m_Items: []
  - m_Id: 1599660034
    m_Localized: "Has estat la meva nota preferida d'avui. L'\xFAnica, de fet."
    m_Metadata:
      m_Items: []
  - m_Id: 1599660035
    m_Localized: 'Tranquil: fins i tot Beethoven va necessitar nou simfonies.'
    m_Metadata:
      m_Items: []
  - m_Id: 1599660036
    m_Localized: "Final, aplaudiments, tel\xF3. I la protagonista, com sempre: jo."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
