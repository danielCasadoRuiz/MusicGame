%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ComposerDialogues_chopin_ca
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: 5822da7b038047b4c8454084bf4e91bc, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2467484298437784
    m_Localized: "Aquest bombo ha entrat al sal\xF3 amb les botes plenes de fang."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437785
    m_Localized: La melodia demana aire. El compressor li ha posat una cotilla.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437786
    m_Localized: "On \xE9s el rubato? Fins les cortines es mouen amb m\xE9s llibertat."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437787
    m_Localized: "Aquesta ornamentaci\xF3 sembla sucre abocat directament del sac."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437788
    m_Localized: "Tant pedal electr\xF2nic i ni un sol sospir ben frasejat."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437789
    m_Localized: La veu rellisca entre notes com una cullera en un plat buit.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437790
    m_Localized: Quina delicadesa de platets. Han servit la vaixella amb una pala.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437791
    m_Localized: Aquest acompanyament trepitja la melodia i encara li demana ballar.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437792
    m_Localized: Un nocturn amb aquests llums? No hi dormiria ni una arna.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437793
    m_Localized: "Les notes arriben puntuals. La gr\xE0cia ha perdut el carruatge."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437794
    m_Localized: "Aquella frase respirava amb gust. Em temo que he perdut amb eleg\xE0ncia."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437795
    m_Localized: "El baix era discret i efica\xE7. Una educaci\xF3 que no esperava
      trobar aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437796
    m_Localized: "Hi havia un mat\xEDs preci\xF3s. L'he sentit abans de fer aquesta
      ganyota."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437797
    m_Localized: "La melodia tenia cantabile. Quina falta de consideraci\xF3 envers
      els meus prejudicis."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437798
    m_Localized: Aquell retard expressiu estava ben mesurat. La derrota, massa puntual.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437799
    m_Localized: "Admeto que l'ornament embellia la frase. No calia embellir-me tamb\xE9
      la derrota."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437800
    m_Localized: "La textura deixava espai a la veu. M'hi hauria assegut, si no hagu\xE9s
      caigut abans."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437801
    m_Localized: Aquell acord tenia tendresa. No ho anuncieu amb un bombo, si us
      plau.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437802
    m_Localized: "La pulsaci\xF3 era flexible. La meva desaprovaci\xF3 tamb\xE9 ha
      hagut de cedir."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437803
    m_Localized: "El final era delicat. Gaireb\xE9 ha tingut el detall de no humiliar-me."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437804
    m_Localized: "Ha guanyat el mat\xEDs. Podeu retirar les botes del sal\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437805
    m_Localized: "La melodia necessitava respirar. Ja t\xE9 tot el silenci que volia."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437806
    m_Localized: "Quina derrota m\xE9s r\xEDgida. El metr\xF2nom deu estar orgull\xF3s."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437807
    m_Localized: "L'ornament no ha tapat el buit. Nom\xE9s l'ha emmarcat amb puntes."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437808
    m_Localized: "Una vict\xF2ria sense aixecar la veu. Proveu-ho algun dia."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437809
    m_Localized: Aquell acompanyament tan invasiu pot acompanyar la derrota fins
      a la porta.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437810
    m_Localized: "La sensibilitat no es compra amb un efecte de reverberaci\xF3.
      Quin descobriment."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437811
    m_Localized: "He ven\xE7ut. El plat finalment ha deixat de barallar-se amb la
      cullera."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437812
    m_Localized: "Tantes notes lliscants i cap no ha sabut aterrar amb gr\xE0cia."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437813
    m_Localized: "Una \xFAltima recomanaci\xF3: menys cops al piano imaginari i m\xE9s
      m\xFAsica."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
