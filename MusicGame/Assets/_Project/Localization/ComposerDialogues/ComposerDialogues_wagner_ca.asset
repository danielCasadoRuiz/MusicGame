%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ComposerDialogues_wagner_ca
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: 6dc5990bc991ef149834d19bb7210bbb, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2467484298438024
    m_Localized: "Aquest tema s'acaba abans d'haver-se presentat amb tots els t\xEDtols!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438025
    m_Localized: "El baix promet un gegant. Nom\xE9s arriba una calaixera enfadada."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438026
    m_Localized: "On \xE9s la tensi\xF3 harm\xF2nica? Aquesta espera t\xE9 gust de
      sala de dentista."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438027
    m_Localized: "Un motiu hauria de transformar-se. Aquest nom\xE9s canvia de jaqueta."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438028
    m_Localized: Han resolt l'acord tan aviat que el drama encara s'estava cordant
      les botes!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438029
    m_Localized: Tanta boira sonora i cap muntanya al darrere!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438030
    m_Localized: La veu anuncia una gesta. L'acompanyament sembla que busqui aparcament.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438031
    m_Localized: "Aquest cl\xEDmax \xE9s una escala de tres graons amb pretensions
      d'altar."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438032
    m_Localized: "Una tornada no \xE9s un dest\xED inevitable nom\xE9s perqu\xE8
      hi posin un plat!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438033
    m_Localized: "L'orquestraci\xF3 infla el pit. A dins hi ha un globus de fira."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438034
    m_Localized: "Aquella tensi\xF3 sabia sostenir-se. La meva superioritat ha estat
      menys estable."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438035
    m_Localized: "El motiu s'ha transformat amb for\xE7a. M'ha arrabassat la vict\xF2ria
      en una altra forma!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438036
    m_Localized: "El cl\xEDmax tenia pes dram\xE0tic. M'ha aixafat amb totes les
      conseq\xFC\xE8ncies."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438037
    m_Localized: "Aquell baix era imponent. D'acord, la calaixera tenia \xE0nima."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438038
    m_Localized: "La resoluci\xF3 s'ha fet esperar amb criteri. La meva derrota no
      tenia tanta paci\xE8ncia."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438039
    m_Localized: "Hi havia continu\xEFtat entre les seccions. Ni una escletxa per
      fugir-ne!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438040
    m_Localized: Aquell color instrumental suggeria grandesa. Detesto els suggeriments
      ben fonamentats.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438041
    m_Localized: Admeto que la tornada culminava el viatge. Jo n'he baixat sense
      equipatge.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438042
    m_Localized: "La melodia tenia un prop\xF2sit. Sembla que era destronar-me amb
      bona afinaci\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438043
    m_Localized: "Aquest final tenia una escala digna. La meva protesta necessitar\xE0
      un escenari m\xE9s gran."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438044
    m_Localized: "El dest\xED s'ha pronunciat! I ha demanat m\xE9s desenvolupament
      tem\xE0tic."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438045
    m_Localized: "Aquell cl\xEDmax ha caigut del seu tamboret. El tron queda ben
      lluny!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438046
    m_Localized: "He ven\xE7ut! La boira pot retirar-se: no amagava cap epopeia."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438047
    m_Localized: El motiu ha canviat de jaqueta. La derrota li ha pres les mides.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438048
    m_Localized: "Quina resoluci\xF3 m\xE9s precipitada! Fins el desastre exigia
      un segon acte."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438049
    m_Localized: "La grandesa no cabia al bucle. La derrota hi ha entrat comod\xEDssima."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438050
    m_Localized: Aquest baix anunciava gegants. Han vingut a recollir els mobles.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438051
    m_Localized: "Vict\xF2ria monumental! Reserveu la sirena ascendent per al cami\xF3
      que reculli els efectes."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438052
    m_Localized: "La tornada reclamava un dest\xED heroic. Li han assignat una sortida
      lateral."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298438053
    m_Localized: "Cau el tel\xF3 sobre l'acord sense prop\xF2sit! Que ning\xFA en
      demani una versi\xF3 estesa."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
