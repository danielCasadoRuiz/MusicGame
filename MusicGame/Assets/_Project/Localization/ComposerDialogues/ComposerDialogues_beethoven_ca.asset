  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ComposerDialogues_beethoven_ca
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ca
  m_SharedData: {fileID: 11400000, guid: b24b9aaea17409d46890dc1415612d58, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2467484298437724
    m_Localized: AQUEST BOMBO VOL TRUCAR A LA PORTA O ENDERROCAR LA CASA?!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437725
    m_Localized: Tot sona immens! Fins i tot la falta d'idees!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437726
    m_Localized: "On s\xF3n els contrastos? Han planxat la m\xFAsica amb una locomotora!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437727
    m_Localized: Aquest crescendo puja molt per arribar a una cadira buida.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437728
    m_Localized: La melodia hauria de plantar cara al baix, no amagar-se sota la
      catifa!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437729
    m_Localized: "Quina entrada m\xE9s t\xEDmida! Que el tema entri amb les espatlles!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437730
    m_Localized: "El volum t\xE9 m\xFAsculs. L'expressi\xF3 s'ha quedat al vestidor."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437731
    m_Localized: Un altre cop el mateix ritme? Fins les tempestes canvien de mal
      humor!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437732
    m_Localized: Han comprimit el drama fins que cap en una llauna!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437733
    m_Localized: "Aquesta pausa no crea tensi\xF3. Sembla que busquin l'endoll."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437734
    m_Localized: "Aquell esclat tenia for\xE7a! M'ha tombat a mi i gaireb\xE9 el
      faristol!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437735
    m_Localized: MAL LLAMP! La melodia ha plantat cara. Respecto les notes amb punys.
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437736
    m_Localized: "He perdut... per\xF2 aquell contrast m'ha fet saltar de la cadira.
      La cadira \xE9s testimoni!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437737
    m_Localized: "El baix t\xE9 empenta. Ja pot estar content: m'ha emp\xE8s fins
      a la derrota."
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437738
    m_Localized: "Aquell silenci abans de l'entrada... S\xED, funcionava. NO EM FEU
      REPETIR-HO!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437739
    m_Localized: "La tornada t\xE9 car\xE0cter. Un car\xE0cter insuportable, per\xF2
      en t\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437740
    m_Localized: "Hi havia emoci\xF3 sota tot aquell soroll. He hagut d'excavar,
      per\xF2 n'hi havia!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437741
    m_Localized: 'Aquell motiu s''ha fet gran! Massa gran: m''ha passat per sobre.'
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437742
    m_Localized: "La din\xE0mica respirava. Jo ara esbufego, per\xF2 ella respirava!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437743
    m_Localized: "No retiro la queixa pel volum. Nom\xE9s admeto que la m\xFAsica
      tenia nervi!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437744
    m_Localized: "VICT\xD2RIA! El volum no pot fer de compositor!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437745
    m_Localized: El bombo picava fort. El tema havia d'haver picat primer!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437746
    m_Localized: Aquest crescendo s'ha inflat fins a rebentar. Confeti musical!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437747
    m_Localized: "Ha guanyat el contrast! Que alg\xFA ho expliqui al compressor!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437748
    m_Localized: Tanta energia per acabar com un timbal sense pell!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437749
    m_Localized: "He ven\xE7ut abans que aquella melodia trob\xE9s el coratge!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437750
    m_Localized: "La tornada demanava pot\xE8ncia. Li faltava una ra\xF3 per cridar!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437751
    m_Localized: "Ja est\xE0! El drama ha derrotat la batedora!"
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437752
    m_Localized: Ni cent altaveus salvarien un tema que camina de puntetes!
    m_Metadata:
      m_Items: []
  - m_Id: 2467484298437753
    m_Localized: "Final contundent! El meu. El seu encara est\xE0 buscant el bot\xF3."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
